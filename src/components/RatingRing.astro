---
interface Props {
  rating: number
  class?: string
}

const { rating, class: className } = Astro.props

// Five 72° segments with a small transparent gap either side, one per point.
const segments = Array.from({ length: 5 }, (_, i) => {
  const start = i * 72
  const colour = i < rating ? 'var(--color-ink)' : 'var(--color-ink-faint)'
  return `transparent ${start}deg ${start + 2}deg, ${colour} ${start + 2}deg ${start + 70}deg, transparent ${start + 70}deg ${start + 72}deg`
})
---

<div
  class:list={['ring', className]}
  style={`--ring: conic-gradient(${segments.join(', ')})`}
>
  <slot>
    <span class="ring__empty"></span>
  </slot>
</div>

<style>
  .ring {
    aspect-ratio: 1;
    border-radius: 50%;
    padding: var(--ring-width, 7px);
    background: var(--ring);
  }
  .ring > :global(img),
  .ring__empty {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: var(--ring-gap, 4px) solid var(--color-ground);
  }
  .ring__empty {
    position: relative;
    background: rgb(255 253 249 / 0.08);
  }
  .ring__empty::after {
    content: '';
    position: absolute;
    inset: 22%;
    background: var(--color-ink-muted);
    mask: url('/pizza.svg') center / contain no-repeat;
  }
</style>
