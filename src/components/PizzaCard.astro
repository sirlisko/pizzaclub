---
import { Image } from 'astro:assets'
import RatingRing from './RatingRing.astro'
import { formatDate, type PizzaEntry } from '../lib/content'

interface Props {
  pizza: PizzaEntry
  hidePizzeria?: boolean
}

const { pizza, hidePizzeria = false } = Astro.props
const { location } = pizza.pizzeria
---

<li
  class="pizza"
  data-name={pizza.pizzaName}
  data-pizzeria={pizza.pizzeria.name}
  data-city={location.city}
  data-country={location.country}
  data-rating={pizza.rating}
  data-date={pizza.dateEaten}
  data-price={pizza.price?.amount ?? ''}
>
  <a href={`/pizza/${pizza.slug}/`} class="pizza__link">
    <RatingRing rating={pizza.rating} class="pizza__ring">
      {pizza.photo && (
        <Image
          src={pizza.photo}
          alt=""
          width={300}
          height={300}
          densities={[1, 2]}
          fit="cover"
        />
      )}
    </RatingRing>
    <span class="pizza__name">{pizza.pizzaName}</span>
    <span class="visually-hidden">, rated {pizza.rating} out of 5</span>
    {!hidePizzeria && (
      <span class="pizza__pizzeria">{pizza.pizzeria.name}</span>
    )}
    <span class="pizza__meta">
      {location.city},{' '}
      <time datetime={pizza.dateEaten}>{formatDate(pizza.dateEaten)}</time>
    </span>
    {pizza.notes && <span class="pizza__note">{pizza.notes}</span>}
  </a>
</li>

<style>
  .pizza {
    list-style: none;
  }
  .pizza__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
  }
  .pizza__ring {
    margin-bottom: 0.75rem;
  }
  .pizza__name {
    font-size: 1.5rem;
    line-height: 1.05;
    font-weight: 800;
    font-stretch: 70%;
  }
  .pizza__link:hover .pizza__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .pizza__pizzeria {
    font-weight: 500;
  }
  .pizza__meta {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .pizza__note {
    margin-top: 0.25rem;
    padding-top: 0.375rem;
    border-top: 1px solid var(--color-ink-faint);
    font-size: 0.9375rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
