---
interface Props {
  countries: string[]
}

const { countries } = Astro.props
---

<form class="filter-bar" role="search" onsubmit="return false">
  <label class="filter-bar__search">
    Search
    <input
      type="search"
      id="filter-search"
      placeholder="Pizza, pizzeria or city"
    />
  </label>
  <label>
    Country
    <select id="filter-country">
      <option value="">All countries</option>
      {countries.map((country) => (
        <option value={country}>{country}</option>
      ))}
    </select>
  </label>
  <label>
    Sort
    <select id="filter-sort">
      <option value="date-desc">Newest first</option>
      <option value="date-asc">Oldest first</option>
      <option value="rating-desc">Highest rated</option>
      <option value="rating-asc">Lowest rated</option>
      <option value="price-desc">Priciest first</option>
      <option value="price-asc">Cheapest first</option>
    </select>
  </label>
  <p id="filter-count" class="filter-count" aria-live="polite"></p>
</form>

<script>
  const grid = document.getElementById('pizza-grid')
  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLLIElement>('.pizza'))
    const yearHeadings = new Map(
      Array.from(grid.querySelectorAll<HTMLLIElement>('.year')).map((el) => [
        el.dataset.year!,
        el,
      ])
    )
    const yearLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#year-nav a')
    )
    const yearNav = document.getElementById('year-nav')
    const noResults = document.getElementById('no-results')
    const search = document.getElementById('filter-search') as HTMLInputElement
    const country = document.getElementById(
      'filter-country'
    ) as HTMLSelectElement
    const sort = document.getElementById('filter-sort') as HTMLSelectElement
    const count = document.getElementById(
      'filter-count'
    ) as HTMLParagraphElement

    const yearOf = (card: HTMLLIElement) => card.dataset.date!.slice(0, 4)

    function apply() {
      const query = search.value.trim().toLowerCase()
      const selectedCountry = country.value
      const visiblePerYear = new Map<string, number>()
      let visible = 0

      for (const card of cards) {
        const haystack = [
          card.dataset.name,
          card.dataset.pizzeria,
          card.dataset.city,
          card.dataset.country,
        ]
          .join(' ')
          .toLowerCase()
        const show =
          (!query || haystack.includes(query)) &&
          (!selectedCountry || card.dataset.country === selectedCountry)
        card.hidden = !show
        if (show) {
          visible += 1
          visiblePerYear.set(
            yearOf(card),
            (visiblePerYear.get(yearOf(card)) ?? 0) + 1
          )
        }
      }

      count.textContent = `Showing ${visible} of ${cards.length} pizzas`
      noResults?.toggleAttribute('hidden', visible > 0)

      const [field, direction] = sort.value.split('-') as [
        'date' | 'rating' | 'price',
        'asc' | 'desc',
      ]
      const sorted = [...cards].sort((a, b) => {
        const av =
          field === 'date'
            ? a.dataset.date!
            : parseFloat(a.dataset[field] || '-1')
        const bv =
          field === 'date'
            ? b.dataset.date!
            : parseFloat(b.dataset[field] || '-1')
        if (av < bv) return direction === 'asc' ? -1 : 1
        if (av > bv) return direction === 'asc' ? 1 : -1
        return 0
      })

      // Year headings only make sense while the list is in date order.
      const groupByYear = field === 'date'
      let currentYear: string | null = null
      for (const card of sorted) {
        const year = yearOf(card)
        if (groupByYear && year !== currentYear) {
          const heading = yearHeadings.get(year)
          if (heading) grid!.appendChild(heading)
          currentYear = year
        }
        grid!.appendChild(card)
      }

      for (const [year, heading] of yearHeadings) {
        const n = visiblePerYear.get(year) ?? 0
        heading.hidden = !groupByYear || n === 0
        heading.querySelector('.year__count')!.textContent =
          `${n} pizza${n === 1 ? '' : 's'}`
      }
      yearNav?.toggleAttribute('hidden', !groupByYear)
      for (const link of yearLinks) {
        link.hidden = !visiblePerYear.get(link.dataset.year!)
      }
    }

    search.addEventListener('input', apply)
    country.addEventListener('change', apply)
    sort.addEventListener('change', apply)
    apply()
  }
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .filter-bar label {
    flex: 1 1 9rem;
    max-width: 12.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .filter-bar .filter-bar__search {
    flex: 1 1 100%;
    max-width: none;
  }
  @media (min-width: 40rem) {
    .filter-bar .filter-bar__search {
      flex-basis: 17.5rem;
    }
  }
  .filter-bar input,
  .filter-bar select {
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-char);
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 400;
  }
  .filter-count {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
</style>
