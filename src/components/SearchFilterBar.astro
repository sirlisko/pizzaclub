---
interface Props {
  countries: string[]
}

const { countries } = Astro.props
---

<div class="filter-bar">
  <input
    type="search"
    id="filter-search"
    placeholder="Search pizzeria, city, country…"
  />
  <select id="filter-country">
    <option value="">All countries</option>
    {countries.map((country) => (
      <option value={country}>{country}</option>
    ))}
  </select>
  <select id="filter-sort">
    <option value="date-desc">Newest first</option>
    <option value="date-asc">Oldest first</option>
    <option value="rating-desc">Highest rated</option>
    <option value="rating-asc">Lowest rated</option>
    <option value="price-desc">Priciest first</option>
    <option value="price-asc">Cheapest first</option>
  </select>
  <p id="filter-count" class="filter-count" aria-live="polite"></p>
</div>

<script>
  const grid = document.getElementById('pizza-grid')
  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLLIElement>('.pizza'))
    const search = document.getElementById('filter-search') as HTMLInputElement
    const country = document.getElementById(
      'filter-country'
    ) as HTMLSelectElement
    const sort = document.getElementById('filter-sort') as HTMLSelectElement
    const count = document.getElementById(
      'filter-count'
    ) as HTMLParagraphElement

    function apply() {
      const query = search.value.trim().toLowerCase()
      const selectedCountry = country.value
      let visible = 0

      for (const card of cards) {
        const haystack = [
          card.dataset.pizzeria,
          card.dataset.city,
          card.dataset.country,
        ]
          .join(' ')
          .toLowerCase()
        const matchesQuery = !query || haystack.includes(query)
        const matchesCountry =
          !selectedCountry || card.dataset.country === selectedCountry
        const show = matchesQuery && matchesCountry
        card.style.display = show ? '' : 'none'
        if (show) visible += 1
      }

      count.textContent = `Showing ${visible} of ${cards.length} pizzas`

      const [field, direction] = sort.value.split('-') as [
        'date' | 'rating' | 'price',
        'asc' | 'desc',
      ]
      const sorted = [...cards].sort((a, b) => {
        const av =
          field === 'price'
            ? parseFloat(a.dataset.price || '-1')
            : (a.dataset[field] ?? '')
        const bv =
          field === 'price'
            ? parseFloat(b.dataset.price || '-1')
            : (b.dataset[field] ?? '')
        if (av < bv) return direction === 'asc' ? -1 : 1
        if (av > bv) return direction === 'asc' ? 1 : -1
        return 0
      })
      sorted.forEach((card) => grid.appendChild(card))
    }

    search.addEventListener('input', apply)
    country.addEventListener('change', apply)
    sort.addEventListener('change', apply)
    apply()
  }
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    margin: 0 auto var(--space-3);
    max-width: 700px;
  }
  .filter-bar input,
  .filter-bar select {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
    border: none;
  }
  .filter-count {
    flex-basis: 100%;
    margin: var(--space-1) 0 0;
    font-size: 0.85rem;
    opacity: 0.85;
  }
</style>
