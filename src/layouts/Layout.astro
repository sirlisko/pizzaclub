---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'Pizza Club',
  description = "sirLisko's tasty Pizza Adventure by reviewing the best Pizza around the Globe.",
} = Astro.props

const path = Astro.url.pathname
const section = path.startsWith('/map')
  ? 'map'
  : path.startsWith('/stats')
    ? 'stats'
    : 'pizzas'
const nav = [
  { id: 'pizzas', href: '/', label: 'Pizzas' },
  { id: 'map', href: '/map', label: 'Map' },
  { id: 'stats', href: '/stats', label: 'Stats' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="author" content="Luca Lischetti" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b3301f" />
    <link rel="icon" href="/pizza.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..100,400..900&display=swap"
      rel="stylesheet"
    />
    {import.meta.env.PROD && (
      <script
        defer
        data-domain="pizzaclub.sirlisko.com"
        src="https://plausible.io/js/script.js"
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">
        Pizza Club
      </a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={section === item.id ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>
        Eaten and written up by{' '}
        <a href="https://sirlisko.com">Luca Lischetti</a>
      </span>
      <a href="https://github.com/sirlisko/pizzaclub">Source on GitHub</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* White on --color-ground is ~6:1; the old tomato ground was ~3:1. */
    --color-ground: #b3301f;
    --color-ink: #fffdf9;
    --color-ink-muted: rgb(255 253 249 / 0.82);
    --color-ink-faint: rgb(255 253 249 / 0.2);
    --color-char: #2a1712;
    --font: 'Archivo', system-ui, sans-serif;
    --width-condensed: 62%;
    --space-1: 0.5rem;
    --space-2: 1rem;
    --space-3: 1.5rem;
    --space-4: 2.5rem;
    --space-5: 4.5rem;
    --page-width: 75rem;
    --gutter: 1.5rem;
    --radius: 6px;
  }

  * {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  body {
    margin: 0;
    background-color: var(--color-ground);
    color: var(--color-ink);
    font-family: var(--font);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }

  h1,
  h2,
  h3 {
    font-stretch: var(--width-condensed);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-5);
  }

  .pizza-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(11.25rem, calc(50% - 0.625rem)), 1fr)
    );
    gap: var(--space-4) 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .pizza-grid {
      gap: 3rem 2rem;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .site-header,
  .site-footer {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .wordmark {
    font-size: 2.125rem;
    font-weight: 900;
    font-stretch: var(--width-condensed);
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    gap: 1.75rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .site-nav a {
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }
  .site-footer {
    width: min(100% - 2 * var(--gutter), var(--page-width) - 2 * var(--gutter));
    padding: var(--space-4) 0;
    border-top: 1px solid rgb(255 253 249 / 0.3);
    font-size: 0.875rem;
  }
</style>
