---
import Layout from '../layouts/Layout.astro'
import PizzaCard from '../components/PizzaCard.astro'
import RatingRing from '../components/RatingRing.astro'
import SearchFilterBar from '../components/SearchFilterBar.astro'
import { getAllPizzas, type PizzaEntry } from '../lib/content'

const pizzas = await getAllPizzas()
const countries = [
  ...new Set(pizzas.map((p) => p.pizzeria.location.country)),
].sort()

const byYear = new Map<string, PizzaEntry[]>()
for (const pizza of pizzas) {
  const year = pizza.dateEaten.slice(0, 4)
  byYear.set(year, [...(byYear.get(year) ?? []), pizza])
}
const years = [...byYear.keys()]
const countLabel = (n: number) => `${n} pizza${n === 1 ? '' : 's'}`
---

<Layout>
  <div class="page">
    <section class="intro">
      <h1>{pizzas.length} pizzas, each one rated out of five.</h1>
      <div class="legend">
        <RatingRing rating={3} class="legend__ring">
          <span class="legend__hole"></span>
        </RatingRing>
        <p>
          The ring is the rating. Each segment is one point, so a 3 is missing
          two slices.
        </p>
      </div>
    </section>

    <SearchFilterBar countries={countries} />

    <nav id="year-nav" class="year-nav" aria-label="Jump to year">
      {years.map((year) => (
        <a href={`#y${year}`} data-year={year}>
          {year}
        </a>
      ))}
    </nav>

    <ul id="pizza-grid" class="pizza-grid">
      {years.map((year) => (
        <>
          <li class="year" id={`y${year}`} data-year={year}>
            <h2>{year}</h2>
            <span class="year__count">
              {countLabel(byYear.get(year)!.length)}
            </span>
          </li>
          {byYear.get(year)!.map((pizza) => (
            <PizzaCard pizza={pizza} />
          ))}
        </>
      ))}
    </ul>
    <p id="no-results" class="no-results" hidden>
      No pizzas match. Try a shorter search or a different country.
    </p>
  </div>
</Layout>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }
  .intro h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 20rem;
  }
  .legend p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .legend :global(.legend__ring) {
    flex: 0 0 4.5rem;
    --ring-width: 6px;
    --ring-gap: 3px;
  }
  .legend__hole {
    display: block;
    height: 100%;
    border-radius: 50%;
    background: var(--color-ground);
  }
  .year-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0 0 var(--space-2);
    font-weight: 600;
  }
  .year-nav a {
    display: inline-block;
    padding: 0.5rem 0;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .year {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 2px solid var(--color-ink);
    scroll-margin-top: var(--space-2);
  }
  .year:first-child {
    padding-top: var(--space-2);
  }
  .year h2 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5rem);
  }
  .year__count {
    color: var(--color-ink-muted);
  }
  .no-results {
    font-size: 1.25rem;
  }
</style>
