---
import Layout from '../layouts/Layout.astro'
import WorldMap from '../components/WorldMap.astro'
import { getAllPizzerias } from '../lib/content'

const pizzerias = await getAllPizzerias()
const mapped = pizzerias.filter((p) => p.geopoint).length
---

<Layout title="Map | Pizza Club" description="Every pizzeria on the map.">
  <div class="page intro">
    <h1>Map</h1>
    <p>
      {mapped} of {pizzerias.length} pizzerias are on the map. Select a marker
      to open the pizzeria.
    </p>
  </div>
  <WorldMap pizzerias={pizzerias} />
</Layout>

<style>
  .intro {
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }
  .intro h1 {
    margin: 0 0 var(--space-2);
    font-size: clamp(3rem, 8vw, 6.5rem);
  }
  .intro p {
    margin: 0;
  }
</style>
