---
import { Image } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import RatingRing from '../../components/RatingRing.astro'
import {
  getAllPizzas,
  getPizzasByPizzeria,
  formatPrice,
  type PizzaEntry,
} from '../../lib/content'

export async function getStaticPaths() {
  // Newest first, so the previous entry in the list is the later visit.
  const pizzas = await getAllPizzas()
  return pizzas.map((pizza, i) => ({
    params: { slug: pizza.slug },
    props: { pizza, later: pizzas[i - 1], earlier: pizzas[i + 1] },
  }))
}

interface Props {
  pizza: PizzaEntry
  later?: PizzaEntry
  earlier?: PizzaEntry
}

const { pizza, later, earlier } = Astro.props
const price = formatPrice(pizza.price)
const photo = pizza.photo
const alt = `${pizza.pizzaName} at ${pizza.pizzeria.name}`
const longDate = new Date(pizza.dateEaten).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const otherVisits = (await getPizzasByPizzeria(pizza.pizzeria._id)).filter(
  (p) => p._id !== pizza._id
)
---

<Layout
  title={`${pizza.pizzaName} at ${pizza.pizzeria.name} | Pizza Club`}
  description={pizza.notes}
>
  <div class="page">
    <article class="detail">
      {photo ? (
        <button
          type="button"
          class="photo-trigger"
          data-open-photo
          aria-label="View full size photo"
        >
          <RatingRing rating={pizza.rating} class="detail__ring">
            <Image
              src={photo}
              alt={alt}
              width={496}
              height={496}
              densities={[1, 2]}
              fit="cover"
              data-photo-img
            />
          </RatingRing>
          <span
            class="photo-loader"
            data-photo-loader
            aria-hidden="true"
          ></span>
        </button>
      ) : (
        <RatingRing rating={pizza.rating} class="detail__ring" />
      )}

      <div class="detail__text">
        <h1>{pizza.pizzaName}</h1>
        <p class="detail__facts">
          <a href={`/pizzeria/${pizza.pizzeria.slug}/`}>
            {pizza.pizzeria.name}
          </a>{' '}
          in {pizza.pizzeria.location.city}, {pizza.pizzeria.location.country}
          <br />
          <time datetime={pizza.dateEaten}>{longDate}</time>, rated{' '}
          {pizza.rating} out of 5{price && `, ${price}`}
        </p>
        {pizza.notes && (
          <blockquote class="detail__notes">{pizza.notes}</blockquote>
        )}
        {otherVisits.length > 0 && (
          <p class="detail__other">
            <a href={`/pizzeria/${pizza.pizzeria.slug}/`}>
              {otherVisits.length === 1
                ? `1 more pizza at ${pizza.pizzeria.name}`
                : `${otherVisits.length} more pizzas at ${pizza.pizzeria.name}`}
            </a>
          </p>
        )}
      </div>
    </article>

    {photo && (
      <dialog class="photo-dialog" data-photo-dialog>
        <button
          type="button"
          class="photo-dialog__close"
          data-close-photo
          aria-label="Close"
        >
          ✕
        </button>
        <img
          class="photo-dialog__img"
          src={photo.src}
          loading="lazy"
          alt={alt}
        />
      </dialog>
    )}

    <nav class="sequence" aria-label="More pizzas">
      {earlier && (
        <a href={`/pizza/${earlier.slug}/`} class="sequence__link">
          <span class="sequence__label">Earlier</span>
          <span class="sequence__name">
            {earlier.pizzaName} at {earlier.pizzeria.name}
          </span>
        </a>
      )}
      {later && (
        <a
          href={`/pizza/${later.slug}/`}
          class="sequence__link sequence__link--later"
        >
          <span class="sequence__label">Later</span>
          <span class="sequence__name">
            {later.pizzaName} at {later.pizzeria.name}
          </span>
        </a>
      )}
    </nav>
  </div>
</Layout>

<style>
  .detail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) 3.5rem;
    padding: var(--space-4) 0 var(--space-5);
  }
  .photo-trigger,
  .detail > :global(.detail__ring) {
    flex: 1 1 22rem;
    max-width: 32.5rem;
  }
  .detail :global(.detail__ring) {
    --ring-width: 12px;
    --ring-gap: 7px;
  }
  .detail__text {
    flex: 1 1 26rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 37.5rem;
  }
  .detail__text h1 {
    margin: 0;
    font-size: clamp(4rem, 10vw, 8.5rem);
    line-height: 0.88;
    overflow-wrap: anywhere;
  }
  .detail__facts {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .detail__notes {
    margin: 0.75rem 0 0;
    max-width: 26ch;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    font-stretch: 85%;
    line-height: 1.3;
    white-space: pre-line;
  }
  .detail__other {
    margin: 0;
  }
  .sequence {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 253 249 / 0.3);
  }
  .sequence__link {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    max-width: 30rem;
    text-decoration: none;
  }
  .sequence__link--later {
    margin-left: auto;
    text-align: right;
  }
  .sequence__label {
    color: var(--color-ink-muted);
  }
  .sequence__name {
    font-size: 1.375rem;
    font-weight: 800;
    font-stretch: 70%;
    line-height: 1.15;
  }
  .sequence__link:hover .sequence__name {
    text-decoration: underline;
  }
  .photo-trigger {
    position: relative;
    display: block;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    cursor: zoom-in;
  }
  .photo-loader {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px;
    border: 3px solid var(--color-ink);
    border-top-color: var(--color-ground);
    border-radius: 100%;
    animation: photo-loader-spin 0.8s linear infinite;
    transition: opacity 0.15s ease;
  }
  .photo-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  @keyframes photo-loader-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .photo-dialog {
    max-width: min(90vw, 800px);
    max-height: 90vh;
    border: none;
    border-radius: 8px;
    padding: 0;
    background: transparent;
  }
  .photo-dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .photo-dialog__img {
    display: block;
    max-width: min(90vw, 800px);
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    background: #e8e8e8;
    color: transparent;
  }
  .photo-dialog__close {
    position: absolute;
    top: var(--space-1);
    right: var(--space-1);
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 100%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  const trigger = document.querySelector('[data-open-photo]')
  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-photo-dialog]'
  )
  const closeBtn = document.querySelector('[data-close-photo]')

  trigger?.addEventListener('click', () => dialog?.showModal())
  closeBtn?.addEventListener('click', () => dialog?.close())
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close()
  })

  const photoImg = document.querySelector<HTMLImageElement>('[data-photo-img]')
  const photoLoader = document.querySelector('[data-photo-loader]')
  const hidePhotoLoader = () => photoLoader?.classList.add('is-hidden')
  if (photoImg) {
    if (photoImg.complete) {
      hidePhotoLoader()
    } else {
      photoImg.addEventListener('load', hidePhotoLoader)
      photoImg.addEventListener('error', hidePhotoLoader)
    }
  }
</script>
