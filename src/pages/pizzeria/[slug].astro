---
import Layout from '../../layouts/Layout.astro'
import PizzaCard from '../../components/PizzaCard.astro'
import {
  getAllPizzeriaSlugs,
  getPizzeriaBySlug,
  getPizzasByPizzeria,
  formatDate,
} from '../../lib/content'

export async function getStaticPaths() {
  const slugs = await getAllPizzeriaSlugs()
  return slugs.map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
const pizzeria = await getPizzeriaBySlug(slug!)
const pizzas = pizzeria ? await getPizzasByPizzeria(pizzeria._id) : []

// pizzas is sorted dateEaten desc (see getPizzasByPizzeria), so the first and
// last entries are the most recent and the earliest visit.
const avgRating = pizzas.length
  ? pizzas.reduce((sum, p) => sum + p.rating, 0) / pizzas.length
  : 0
const firstVisit = pizzas[pizzas.length - 1]?.dateEaten
const lastVisit = pizzas[0]?.dateEaten
---

<Layout
  title={pizzeria ? `${pizzeria.name} | Pizza Club` : 'Not found | Pizza Club'}
  description={
    pizzeria
      ? `${pizzas.length} pizza${pizzas.length === 1 ? '' : 's'} at ${pizzeria.name}.`
      : undefined
  }
>
  <div class="page">
    {pizzeria ? (
      <>
        <header class="pizzeria-header">
          <h1>{pizzeria.name}</h1>
          <p class="pizzeria-where">
            {pizzeria.location.city}, {pizzeria.location.country}
          </p>
          {pizzas.length > 1 ? (
            <dl class="pizzeria-stats">
              <div>
                <dt>Pizzas eaten here</dt>
                <dd>{pizzas.length}</dd>
              </div>
              <div>
                <dt>Average rating</dt>
                <dd>{avgRating.toFixed(1)}</dd>
              </div>
              <div>
                <dt>First visit</dt>
                <dd>{formatDate(firstVisit)}</dd>
              </div>
              <div>
                <dt>Last visit</dt>
                <dd>{formatDate(lastVisit)}</dd>
              </div>
            </dl>
          ) : (
            <p class="pizzeria-where">1 pizza eaten here</p>
          )}
        </header>
        <ul class="pizza-grid">
          {pizzas.map((pizza) => (
            <PizzaCard pizza={pizza} hidePizzeria />
          ))}
        </ul>
      </>
    ) : (
      <p>Couldn't find that pizzeria.</p>
    )}
  </div>
</Layout>

<style>
  .pizzeria-header {
    padding: var(--space-4) 0;
  }
  .pizzeria-header h1 {
    margin: 0 0 var(--space-2);
    font-size: clamp(3rem, 8vw, 6.5rem);
  }
  .pizzeria-where {
    margin: 0;
    font-size: 1.25rem;
  }
  .pizzeria-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-3) 0 0;
  }
  .pizzeria-stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .pizzeria-stats dt {
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
  }
  .pizzeria-stats dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    font-stretch: 70%;
  }
</style>
